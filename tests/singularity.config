/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-test config: minimal test inputs + a container engine
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/test.config plus Singularity enabled, for the nf-test cases that
    really execute a tool rather than running -stub-run or failing at
    parameter/samplesheet validation.

    nf-test selects profiles globally (`profile "test"` in nf-test.config) and
    nf-test 0.9.5 has no per-test `profile` directive, so a per-test `config`
    is how a single test opts into a container engine.

    Only processes that declare a `container` directive are affected; sibling
    processes without one (e.g. ARCASHLA_EXTRACT's samtools, which is not yet
    containerized) continue to run on the host.
----------------------------------------------------------------------------------------
*/

includeConfig '../conf/test.config'

singularity.enabled    = true
singularity.autoMounts = true
conda.enabled          = false
docker.enabled         = false
podman.enabled         = false
shifter.enabled        = false
charliecloud.enabled   = false
apptainer.enabled      = false
