/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'STAR_GENOMEGENERATE' {
        // HLA allele references are a few KB each (vs. gigabases for a full
        // genome), so the module's default 'process_high' label (12 CPUs,
        // 72 GB) is unnecessary and can exceed smaller machines' available
        // CPUs/memory. One CPU and a few hundred MB per allele is more than
        // enough; many alleles still run in parallel across separate tasks.
        cpus   = 1
        memory = { 2.GB * task.attempt }
        // Matches the overhang used by artifacts/scripts/22-star-index-all-hla.
        // --genomeSAindexNbases is deliberately left unset so the module
        // auto-computes a per-allele-appropriate value.
        ext.args = '--sjdbOverhang 100'
        // publishDir's saveAs receives the top-level published name for a
        // directory-type output (here literally "star", the module's fixed
        // output directory name) - it cannot rename the files nested inside
        // it, so the published layout is hlapm/star_index/<allele_key>/star/,
        // mirroring nf-core/rnaseq's own genome/index/star/ convention for
        // this same module rather than fighting Nextflow's directory-level
        // publish semantics.
        publishDir = [
            path: { "${params.outdir}/hlapm/star_index/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'STAR_ALIGN' {
        // MHC-extracted per-sample reads (arcasHLA's HLA-region slice, not
        // whole-transcriptome fastqs) are small, so the module's default
        // 'process_high' label (12 CPUs, 72 GB) is unnecessary; many
        // per-sample-per-allele alignment jobs still run in parallel across
        // separate tasks. Real-world resource tuning against representative
        // read volumes may still be needed - this is a starting point, not
        // a validated ceiling.
        cpus   = 2
        memory = { 4.GB * task.attempt }
        // No downstream quantifier is wired up yet in this iteration (see
        // docs/output.md), so BAM SortedByCoordinate is used as a
        // general-purpose default rather than speculatively reproducing the
        // legacy queryname-sorted convention.
        // --readFilesCommand zcat is required because ARCASHLA_EXTRACT's
        // reads (this subworkflow's input) are always gzip-compressed
        // (*.mhc_1/2.fq.gz); STAR_ALIGN does not auto-detect gzip input and
        // will otherwise read the raw compressed bytes as literal FASTQ
        // text (STAR error: "wrong read ID line format").
        // --limitBAMsortRAM is required because STAR's own internal default
        // BAM-sort-buffer-size check can fatally exit (exit code 102) even
        // when the task has plenty of memory available - this is not
        // host/executor memory contention, and 102 is not in
        // conf/base.config's retry-eligible exit-code set, so simply
        // bumping `memory` above (with or without retries) would not fix a
        // recurrence of this error; the flag must be passed explicitly,
        // sized here as 80% of the task's allocated memory so it scales
        // automatically with `task.attempt`.
        ext.args = { "--outSAMtype BAM SortedByCoordinate --readFilesCommand zcat --limitBAMsortRAM ${(task.memory.toBytes() * 0.8).toLong()}" }
        // Alignment output is per-RNA-sample (unlike the shared per-allele
        // index), so it is published per rna_id/allele_key rather than
        // mirroring hlapm/star_index/<allele_key>/'s shared layout.
        publishDir = [
            path: { "${params.outdir}/hlapm/star_align/${meta.rna_id}/${meta.allele_key}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        // Same per-(RNA sample, allele) BAMs as STAR_ALIGN above (small,
        // MHC-extracted reads against a single-allele reference), so sized
        // the same as STAR_ALIGN's own override just above rather than the
        // module's default 'process_medium' label.
        cpus   = 2
        memory = { 4.GB * task.attempt }
        // -N: queryname-sort in strict ASCII/lexicographic order (not the
        // module's default coordinate-sort, and NOT samtools' own "-n"
        // natural/numeric-aware queryname sort). make_a_table_210804_allHLAgenes.py
        // (HLAPM_QUANTIFY_READS, below) is an unmodified legacy script whose
        // multi-BAM merge does a plain Python string comparison to verify
        // each input BAM is sorted; samtools "-n" natural order (e.g. 520
        // before 1019) disagrees with that plain string comparison (which
        // sorts "1019" before "520"), tripping the script's internal
        // consistency check. "-N" produces the strict ASCII order the
        // script actually expects (matching what Picard's SortSam
        // SORT_ORDER=queryname - what this legacy pipeline was originally
        // built around - itself produces). STAR_ALIGN's own coordinate-sorted
        // BAM output (bam_sorted_aligned) is unaffected - this is an
        // additional, separate sorted copy of the same alignment.
        ext.args   = '-N'
        ext.prefix = { "${meta.id}.queryname" }
        // Additional derived file for the same alignment as STAR_ALIGN
        // above, so it is published alongside it rather than under its own
        // top-level directory.
        publishDir = [
            path: { "${params.outdir}/hlapm/star_align/${meta.rna_id}/${meta.allele_key}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HLAPM_QUANTIFY_READS' {
        // Runs once per RNA sample over that sample's full set of
        // per-allele queryname-sorted BAMs (typically a handful of small,
        // MHC-extracted-read alignments) - sized the same as STAR_ALIGN's
        // override above; a starting point, not a validated ceiling (same
        // caveat as STAR_ALIGN's own sizing comment).
        cpus   = 2
        memory = { 4.GB * task.attempt }
        // Unlike STAR_ALIGN/SAMTOOLS_SORT above (which report versions via
        // the topic-based `versions` channel only), this module emits a
        // real versions.yml path output - explicitly excluded from
        // publishing here, matching the top-level default publishDir's own
        // saveAs (which this withName-level override otherwise replaces).
        publishDir = [
            path: { "${params.outdir}/hlapm/quantify/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'HLAPM_SUMMARIZE_READCOUNTS' {
        publishDir = [
            path: { "${params.outdir}/hlapm/quantify/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        // Runs once per RNA sample against that sample's full whole-genome,
        // coordinate-sorted BAM (--rna_samples' bam/bai columns) - unlike
        // the HLA-allele-scale STAR/samtools overrides above, this is
        // whole-genome-scale work, so the module's own default
        // 'process_medium' label (conf/base.config: 6 CPUs, 36 GB, 8h) is
        // left as-is rather than shrunk; a starting point, not a validated
        // ceiling (same caveat as STAR_ALIGN's own sizing comment above).
        // --countReadPairs -g gene_id matches the legacy
        // 32-extract-rnaseq-featurecounts invocation; -p/-s/-T are already
        // derived by the module itself from meta.single_end/meta.strandedness/
        // task.cpus.
        ext.args = '--countReadPairs -g gene_id'
        publishDir = [
            path: { "${params.outdir}/counts_commonref/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS_HLA' {
        // Runs once per RNA sample against the HLA-region-restricted subset
        // of that sample's original BAM (ARCASHLA_EXTRACT's own intermediate
        // "*.mhc.namesort.bam", not the whole-genome BAM SUBREAD_FEATURECOUNTS
        // above reads) - a much smaller per-region input, so process_low is
        // used instead of the whole-genome call's un-overridden process_medium
        // default. A starting point, not a validated ceiling (same caveat as
        // STAR_ALIGN's own sizing comment above).
        // -R BAM reannotates each input read with its per-read gene
        // assignment, captured via this module's own patched `bam` output
        // (see modules/nf-core/subread/featurecounts/subread-featurecounts.diff);
        // --countReadPairs -g gene_id matches SUBREAD_FEATURECOUNTS's own
        // ext.args above plus the legacy 32-extract-rnaseq-featurecounts
        // invocation's -R BAM flag.
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        ext.args = '-R BAM --countReadPairs -g gene_id'
        // This call's own plain gene-count table (redundant with
        // SUBREAD_FEATURECOUNTS's whole-genome table above, and not this
        // step's point) and its bulky per-read reannotated BAM are both left
        // unpublished intermediates - only the summary log is kept here,
        // plus (downstream, from COUNTS_COMMONREF_HLA_REFORMAT below) the
        // final per-read TSV, matching COUNTS_COMMONREF's own
        // "counts + summary, not every intermediate" convention.
        publishDir = [
            path: { "${params.outdir}/counts_commonref_hla/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                (filename.endsWith('.featureCounts.tsv') || filename.endsWith('.featureCounts.bam')) ? null : filename
            }
        ]
    }

    withName: 'COUNTS_COMMONREF_HLA_REFORMAT' {
        publishDir = [
            path: { "${params.outdir}/counts_commonref_hla/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
