// As in ./nextflow.config: HIBAG comes from the module's own container, not
// the host PATH, and nf-test's pinned `test` profile enables no engine.
singularity.enabled    = true
singularity.autoMounts = true
conda.enabled          = false
docker.enabled         = false

// Deliberately the strict default, which matches nothing against the bundled
// example model, to exercise the no-overlap error path.
params {
    hibag_match_type = 'RefSNP+Position'
    hibag_assembly   = 'hg19'
    hibag_loci       = null
    hibag_min_prob   = 0
    hibag_min_matched_snps = 0.5
}
