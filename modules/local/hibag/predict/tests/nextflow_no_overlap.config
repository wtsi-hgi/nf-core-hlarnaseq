// Deliberately the strict default, which matches nothing against the bundled
// example model, to exercise the no-overlap error path.
params {
    hibag_match_type = 'RefSNP+Position'
    hibag_assembly   = 'hg19'
    hibag_loci       = null
    hibag_min_prob   = 0
    hibag_min_matched_snps = 0.5
}
