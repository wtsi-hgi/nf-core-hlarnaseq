// The bundled HIBAG example model stores SNP positions 1 bp below the
// Illumina manifest coordinates the fixture uses, so only rsID matching finds
// the model's SNPs. See tests/fixtures/hibag/README.md.
params {
    hibag_match_type = 'RefSNP'
    hibag_assembly   = 'hg19'
    hibag_loci       = null
    hibag_min_prob   = 0
    hibag_min_matched_snps = 0.5
}
