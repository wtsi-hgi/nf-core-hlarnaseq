// HIBAG_PREDICT now declares its own conda/container environment, so this test
// must run under a container engine - nf-test.config pins `profile "test"`,
// which enables no engine at all, and without this the test would silently
// resolve HIBAG from the host PATH and prove nothing about the new directive.
// nf-test 0.9.5 has no per-test `profile` directive, so a per-test config is
// how a single test opts into an engine. Singularity, to match the existing
// tests/singularity.config used by the other tool-executing test in this repo.
singularity.enabled    = true
singularity.autoMounts = true
conda.enabled          = false
docker.enabled         = false

// The bundled HIBAG example model stores SNP positions 1 bp below the
// Illumina manifest coordinates the fixture uses, so only rsID matching finds
// the model's SNPs. See tests/fixtures/hibag/README.md.
params {
    hibag_match_type = 'RefSNP'
    hibag_assembly   = 'hg19'
    hibag_loci       = null
    hibag_min_prob   = 0
    hibag_min_matched_snps = 0.5
}
