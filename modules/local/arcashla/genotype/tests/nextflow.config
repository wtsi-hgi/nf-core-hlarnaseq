// ARCASHLA_GENOTYPE declares its own conda/container environment, so this test
// must run under a container engine - nf-test.config pins `profile "test"`,
// which enables no engine at all, and without this the test would silently
// resolve arcasHLA from the host PATH. That matters twice over here: this test
// is the regression guard for the reference directory being staged as a real
// process input so the container engine bind-mounts it (see ../main.nf), and
// on the host PATH there is no mount to get wrong. nf-test 0.9.5 has no
// per-test `profile` directive, so a per-test config is how a single test opts
// into an engine. Singularity, matching modules/local/hibag/predict/tests.
singularity.enabled    = true
singularity.autoMounts = true
conda.enabled          = false
docker.enabled         = false
